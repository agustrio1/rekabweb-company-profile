# Salin file ini menjadi .env di server, lalu isi nilainya.
# Nilai yang mengandung spasi atau karakter # $ " wajib dibungkus tanda kutip.
# Password yang persis bernilai true, false, atau null juga harus dikutip.

APP_NAME="Nama Perusahaan"
APP_ENV=production
APP_DEBUG=false
# Alamat website, tanpa garis miring di akhir
APP_URL=https://domainkamu.com
APP_TIMEZONE=Asia/Jakarta

# Kunci formulir. Buat dengan: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=

# Isi true hanya kalau memakai Cloudflare atau proxy tepercaya lain
TRUST_PROXY=false
# Paksa HTTPS. Otomatis berlaku kalau APP_URL berawalan https://
FORCE_HTTPS=true
# on, report-only, atau off
CSP=on
MEDIA_CONVERT=true

# Di cPanel, nama database dan user biasanya berawalan nama akun, misalnya akun_company
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=akun_company
DB_USERNAME=akun_user
DB_PASSWORD="ganti-dengan-password-database"

# Notifikasi email inquiry (opsional). Kosongkan MAIL_HOST untuk mematikan.
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Nama Perusahaan"
MAIL_TO=